# ---- Providers -------------------------------------------------------------
# Hosted (default, used on Render): Groq for the LLM, fastembed (in-process CPU) for embeddings.
LLM_PROVIDER=groq
EMBEDDING_PROVIDER=fastembed
GROQ_API_KEY=            # from https://console.groq.com/keys - never commit a real key
GROQ_MODEL=openai/gpt-oss-20b
# FASTEMBED_MODEL=BAAI/bge-small-en-v1.5

# Fully local alternative: set both providers to "ollama" (then re-ingest).
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.1:8b
OLLAMA_EMBED_MODEL=nomic-embed-text

# ---- Retrieval ---------------------------------------------------------------
CHROMA_PERSIST_DIRECTORY=../data/chroma
TOP_K=5
RELEVANCE_THRESHOLD=0.70

# ---- Optional ------------------------------------------------------------------
# DEFAULT_SCHEME=Parag Parikh Flexi Cap Fund   # used when a scheme-specific question names no scheme
# RATE_LIMIT_PER_MINUTE=12                     # per visitor, /api/chat only (0 disables)
# CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

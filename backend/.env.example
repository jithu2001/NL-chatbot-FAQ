OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.1:8b
OLLAMA_EMBED_MODEL=nomic-embed-text
CHROMA_PERSIST_DIRECTORY=../data/chroma
TOP_K=5
RELEVANCE_THRESHOLD=0.70

# Optional
# DEFAULT_SCHEME=Parag Parikh Flexi Cap Fund   # used when a scheme-specific question names no scheme
# OLLAMA_NUM_CTX=8192                          # context window passed to Ollama
# OLLAMA_TIMEOUT_SECONDS=120
# CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# RATE_LIMIT_PER_MINUTE=12                     # per visitor, /api/chat only (0 disables)
